# Local API: copy this file to backend/.env
# Vercel API: copy backend/.env.production into the backend project's Environment Variables.
# Do not commit real passwords.

PORT=5000
NODE_ENV=development
APP_TIMEZONE=Asia/Kolkata

# Local site
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Production site (use these in backend/.env.production / Vercel, not here)
# CLIENT_URL=https://urbanservice-woad.vercel.app
# CORS_ORIGIN=https://urbanservice-woad.vercel.app,http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=urban_services

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Urban Services
SMTP_FROM_EMAIL=noreply@urbanservices.local

GOOGLE_MAPS_API_KEY=
PAYMENT_SECRET=
